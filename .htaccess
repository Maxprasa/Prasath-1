# kuvadoo.fi — Hostinger (LiteSpeed/Apache). PHP site, content in /data (private).
Options -Indexes
DirectoryIndex index.php

# Repository-only and private files are never served
RedirectMatch 404 ^/(\.git|\.claude|docs|tools|app|data)(/|$)
RedirectMatch 404 (?i)^/(CLAUDE\.md|DEPLOY\.md|router\.php|\.gitignore|\.user\.ini|.*\.zip)$

<IfModule mod_rewrite.c>
  RewriteEngine On
  # One address: https://kuvadoo.fi (no www)
  RewriteCond %{HTTP_HOST} ^www\.kuvadoo\.fi$ [NC]
  RewriteRule ^ https://kuvadoo.fi%{REQUEST_URI} [R=301,L]
  # (Hostinger already redirects http → https when SSL is on.)
  # Real files (CSS, images, fonts) are served directly; everything else goes to index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Uploaded media: never run as code
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|png|svg|woff2)$">
    Header set X-Content-Type-Options nosniff
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
